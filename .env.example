# Google Cloud Platform
GCP_PROJECT_ID=your_gcp_project_id

# 로컬 개발: JSON 파일 경로 직접 지정
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json

# Render 배포: JSON 파일을 base64로 인코딩해서 붙여넣기
# PowerShell: [Convert]::ToBase64String([System.IO.File]::ReadAllBytes('service-account.json'))
# Mac/Linux:  base64 -w 0 service-account.json
# (GOOGLE_APPLICATION_CREDENTIALS와 둘 중 하나만 설정하면 됩니다)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Supabase Dashboard > Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
# Supabase Dashboard > Project Settings > API > service_role (서버 전용, 절대 외부 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_DEBUG=false

# Cache TTL (seconds) — BigQuery 결과 캐시 유지 시간 (기본 5분)
CACHE_TTL=300
